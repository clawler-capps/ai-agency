# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create a product + price in the Stripe dashboard for the $1,000 assessment,
# then paste the price ID here (starts with price_...)
STRIPE_PRICE_ID=price_...

# Stripe will redirect here after a successful / canceled checkout
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Resend (email provider) ──────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_...

# The "from" address used when sending notification emails (must be a verified
# Resend domain or Resend's shared domain for testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where assessment lead notifications should be sent
TYLER_NOTIFICATION_EMAIL=tyler@example.com

# ─── Pre-call questionnaire ───────────────────────────────────────────────────
# Legacy. Use LEAD_WEBHOOK_URL instead. Still honored for questionnaire
# submissions if set.
QUESTIONNAIRE_WEBHOOK_URL=

# ─── CRM (GoHighLevel or any CRM) ─────────────────────────────────────────────
# Inbound webhook URL. Assessment, contact, and questionnaire submissions are
# POSTed here as JSON with a "source" field. If unset, leads are logged and
# emailed only.
LEAD_WEBHOOK_URL=

# Scheduler link used by every Book a Call button (GoHighLevel, Cal.com, or
# Calendly). If unset, buttons open an email to Tyler. Build-time value.
NEXT_PUBLIC_BOOKING_URL=

# Optional embed link for the scheduler on the assessment results page.
# Defaults to NEXT_PUBLIC_BOOKING_URL.
NEXT_PUBLIC_BOOKING_EMBED_URL=

# Chat widget loader script, for example
# https://widgets.leadconnectorhq.com/loader.js. If unset, no widget loads.
NEXT_PUBLIC_CHAT_WIDGET_SRC=

# Widget id from the chat widget snippet (data-widget-id).
NEXT_PUBLIC_CHAT_WIDGET_ID=

# Resources URL from the chat widget snippet (data-resources-url).
NEXT_PUBLIC_CHAT_WIDGET_RESOURCES_URL=
