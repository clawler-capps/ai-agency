# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create a product + price in the Stripe dashboard for the $1,000 assessment,
# then paste the price ID here (starts with price_...)
STRIPE_PRICE_ID=price_...

# Stripe will redirect here after a successful / canceled checkout
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Resend (email provider) ──────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_...

# The "from" address used when sending notification emails (must be a verified
# Resend domain or Resend's shared domain for testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where assessment lead notifications should be sent
TYLER_NOTIFICATION_EMAIL=tyler@example.com

# ─── Pre-call questionnaire ───────────────────────────────────────────────────
# n8n (or any) webhook URL that the /pre-call form submissions are forwarded to.
# If unset, submissions are logged server-side and the UI still succeeds.
QUESTIONNAIRE_WEBHOOK_URL=https://your-n8n-instance/webhook/...
