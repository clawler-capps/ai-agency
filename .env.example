# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create a product + price in the Stripe dashboard for the $1,000 assessment,
# then paste the price ID here (starts with price_...)
STRIPE_PRICE_ID=price_...

# Stripe will redirect here after a successful / canceled checkout
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Resend (email provider) ──────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_...

# The "from" address used when sending notification emails (must be a verified
# Resend domain or Resend's shared domain for testing)
RESEND_FROM_EMAIL="Tyler at Sacramento AI Agency <reports@sacramentoaiagency.com>"

# Reply-To on every system email
RESEND_REPLY_TO=tyler@sacramentoaiagency.com

# Full email footer line with mailing address (CAN-SPAM), e.g.
# "Sacramento AI Agency · 123 Main St, Sacramento, CA 95814". Set on Vercel.
MAILING_ADDRESS=

# Where assessment lead notifications should be sent
TYLER_NOTIFICATION_EMAIL=tyler@example.com

# ─── CRM (GoHighLevel or any CRM) ─────────────────────────────────────────────
# GoHighLevel Inbound Webhook URL. Assessment, contact, and questionnaire
# submissions are POSTed here as JSON with a "source" field.
LEAD_WEBHOOK_URL=

# Set to true on Vercel Production only. When unset, nothing is posted to the
# webhook, so Preview deploys never create CRM contacts.
FUNNEL_ENABLED=

# Optional second GHL Inbound Webhook for report results (status, top
# opportunity, value), kept separate so the lead workflow doesn't run twice.
# If unset, the write-back is skipped.
REPORT_WEBHOOK_URL=

# Claude API key for the AI report email (claude-sonnet-5-5).
ANTHROPIC_API_KEY=

# Scheduler link used by every Book a Call button (GoHighLevel, Cal.com, or
# Calendly). If unset, buttons open an email to Tyler. Build-time value.
NEXT_PUBLIC_BOOKING_URL=

# Optional embed link for the scheduler on the assessment results page.
# Defaults to NEXT_PUBLIC_BOOKING_URL.
NEXT_PUBLIC_BOOKING_EMBED_URL=

